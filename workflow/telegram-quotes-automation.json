        "jsCode": "const raw = $node[\"HTTP Request\"].json.choices[0].message.content;\n\nlet content = raw\n  .trim()\n  .replace(/^```json\\s*/i, \"\")\n  .replace(/^```\\s*/i, \"\")\n  .replace(/\\s*```$/i, \"\")\n  .trim();\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(content);\n} catch (error) {\n  const match = content.match(/\\{[\\s\\S]*\\}/);\n\n  if (!match) {\n    throw new Error(\"خروجی DeepSeek JSON معتبر نیست: \" + content);\n  }\n\n  parsed = JSON.parse(match[0]);\n}\n\nconst normalize = (text) => {\n  return String(text || \"\")\n    .replace(/[يى]/g, \"ی\")\n    .replace(/[ك]/g, \"ک\")\n    .replace(/‌/g, \"\")\n    .replace(/[^\\u0600-\\u06FFa-zA-Z0-9\\s]/g, \"\")\n    .replace(/\\s+/g, \" \")\n    .trim()\n    .toLowerCase();\n};\n\nconst newQuote = normalize(parsed.quote);\n\nconst rows = $input.all();\n\nlet maxSimilarity = 0;\nlet mostSimilarQuote = \"\";\n\nconst newWords = new Set(newQuote.split(\" \"));\n\nfor (const item of rows) {\n  const oldQuote = normalize(item.json[\"متن\"]);\n\n  if (!oldQuote) continue;\n\n  const oldWords = new Set(oldQuote.split(\" \"));\n\n  const intersection = [...newWords]\n    .filter(word => oldWords.has(word))\n    .length;\n\n  const union = new Set([\n    ...newWords,\n    ...oldWords\n  ]).size;\n\n  const similarity = union > 0\n    ? intersection / union\n    : 0;\n\n  if (similarity > maxSimilarity) {\n    maxSimilarity = similarity;\n    mostSimilarQuote = item.json[\"متن\"];\n  }\n}\n\nreturn [{\n  json: {\n    quote: parsed.quote,\n    author: parsed.author,\n    image_prompt: parsed.image_prompt || \"\",\n    نوع_پست: $node[\"Edit Fields1\"].json[\"نوع_پست\"],\n    similarity: Math.round(maxSimilarity * 100),\n    is_duplicate: maxSimilarity >= 0.75,\n    most_similar_quote: mostSimilarQuote\n  }\n}];"
      },
