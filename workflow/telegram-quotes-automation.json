      "parameters": {
        "jsCode": "const raw = $node[\"HTTP Request\"].json.choices[0].message.content;\n\nlet content = raw\n  .trim()\n  .replace(/^```json\\s*/i, \"\")\n  .replace(/^```\\s*/i, \"\")\n  .replace(/\\s*```$/i, \"\")\n  .trim();\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(content);\n} catch (error) {\n  const match = content.match(/\\{[\\s\\S]*\\}/);\n\n  if (!match) {\n    throw new Error(\"خروجی DeepSeek JSON معتبر نیست: \" + content);\n  }\n\n  parsed = JSON.parse(match[0]);\n}\n\n// ------------------------------\n// نرمال‌سازی متن\n// ------------------------------\n\nconst normalize = (text) => {\n  return String(text || \"\")\n    .replace(/[يى]/g, \"ی\")\n    .replace(/[ك]/g, \"ک\")\n    .replace(/‌/g, \"\")\n    .replace(/[^\\u0600-\\u06FFa-zA-Z0-9\\s]/g, \"\")\n    .replace(/\\s+/g, \" \")\n    .trim()\n    .toLowerCase();\n};\n\nconst newQuote = normalize(parsed.quote);\nconst newAuthor = normalize(parsed.author);\n\nconst rows = $input.all();\n\n// ------------------------------\n// بررسی شباهت نقل‌قول\n// ------------------------------\n\nlet maxSimilarity = 0;\nlet mostSimilarQuote = \"\";\n\nconst newWords = new Set(\n  newQuote\n    .split(\" \")\n    .filter(word => word.length > 0)\n);\n\nfor (const item of rows) {\n\n  const oldQuote = normalize(item.json[\"متن\"]);\n\n  if (!oldQuote) continue;\n\n  const oldWords = new Set(\n    oldQuote\n      .split(\" \")\n      .filter(word => word.length > 0)\n  );\n\n  const intersection = [...newWords]\n    .filter(word => oldWords.has(word))\n    .length;\n\n  const union = new Set([\n    ...newWords,\n    ...oldWords\n  ]).size;\n\n  const similarity = union > 0\n    ? intersection / union\n    : 0;\n\n  if (similarity > maxSimilarity) {\n    maxSimilarity = similarity;\n    mostSimilarQuote = item.json[\"متن\"];\n  }\n}\n\n// ------------------------------\n// بررسی گوینده در 10 رکورد آخر\n// ------------------------------\n\nconst recentRows = rows.slice(-10);\n\nlet isAuthorDuplicate = false;\nlet repeatedAuthor = \"\";\n\nfor (const item of recentRows) {\n\n  const oldAuthor = normalize(item.json[\"گوینده\"]);\n\n  if (!oldAuthor || !newAuthor) continue;\n\n  if (oldAuthor === newAuthor) {\n    isAuthorDuplicate = true;\n    repeatedAuthor = item.json[\"گوینده\"];\n    break;\n  }\n}\n\n// ------------------------------\n// نتیجه نهایی\n// ------------------------------\n\n// 50 درصد یا بیشتر = تکراری\nconst isQuoteDuplicate = maxSimilarity >= 0.50;\n\n// اگر متن تکراری باشد\n// یا گوینده در 10 رکورد اخیر وجود داشته باشد\n// کل خروجی رد می‌شود\nconst isDuplicate =\n  isQuoteDuplicate || isAuthorDuplicate;\n\n// ------------------------------\n// خروجی\n// ------------------------------\n\nreturn [{\n  json: {\n    quote: parsed.quote,\n    author: parsed.author,\n    image_prompt: parsed.image_prompt || \"\",\n\n    نوع_پست: $node[\"Edit Fields1\"].json[\"نوع_پست\"],\n\n    similarity: Math.round(maxSimilarity * 100),\n\n    is_duplicate: isDuplicate,\n\n    is_quote_duplicate: isQuoteDuplicate,\n\n    is_author_duplicate: isAuthorDuplicate,\n\n    repeated_author: repeatedAuthor,\n\n    most_similar_quote: mostSimilarQuote\n  }\n}];"
      },
